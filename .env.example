# Copy this file to .env and fill in your values. .env is git-ignored.

# --- Flask -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# DRAINWATCH_DATA_DIR=./data

# --- AWS / Amazon Bedrock ------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Credentials: leave these empty to use your AWS CLI login (~/.aws/credentials).
# Set AWS_PROFILE to use a named profile, or fill in the keys directly.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
